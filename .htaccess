# Activar mod_rewrite

RewriteEngine On

# Fallback: si /post/<slug> NO tiene un archivo prerenderizado,
# servirlo dinámicamente vía /post.html?slug=<slug>.
# END detiene toda reescritura para evitar loops con la regla legacy.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html !-f
RewriteRule ^post/([^/.]+)/?$ /post.html?slug=$1 [L,QSA,END]

# Legacy: /post.html?slug=xxx -> /post/xxx (solo en requests externos)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{QUERY_STRING} ^slug=([^&]+)
RewriteRule ^post\.html$ /post/%1? [R=301,L]

# Evitar conflictos con directorios reales

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

# Redirigir de .html a la URL sin extensión

RewriteCond %{THE_REQUEST} \s/([^.]+)\.html [NC]
RewriteRule ^ /%1 [R=301,L]

# Cargar automáticamente el archivo .html si existe

RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# Compresión
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache estático
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
