# Página de error 404 personalizada
ErrorDocument 404 /404.html

RewriteEngine On

# 1) Redirigir /algo.html -> /algo (URL limpia), EXCEPTO /post.html que
#    recibe ?slug= como dispatcher dinámico.
RewriteCond %{REQUEST_URI} !^/post\.html$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{THE_REQUEST} \s/([^.\s]+)\.html [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) Auto-append .html si el archivo existe (sirve las URLs limpias como
#    /quienes, /podcast, /post/<slug> prerenderizado, etc.)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# 3) Fallback: /post/<slug> sin archivo prerenderizado -> servirlo
#    dinámicamente vía /post.html?slug=<slug>. Rewrite interno, la URL
#    limpia se conserva en la barra del navegador.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html !-f
RewriteRule ^post/([^/.]+)/?$ /post.html?slug=$1 [L,QSA]

# Compresión
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache estático
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
